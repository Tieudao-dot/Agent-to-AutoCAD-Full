<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the AutoCAD-independent core of the plugin (JSON codec,
    parameter validation). The sources are linked from ClaudeCAD.Plugin so the
    tests run on any OS with the .NET 8 SDK:  dotnet test plugin/ClaudeCAD.Core.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ClaudeCAD.Plugin\Core\JsonCodec.cs" Link="Core\JsonCodec.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Params.cs" Link="Core\Params.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\ToolException.cs" Link="Core\ToolException.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Geometry.cs" Link="Core\Geometry.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\UpdateLogic.cs" Link="Core\UpdateLogic.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Logger.cs" Link="Core\Logger.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\MarkdownLite.cs" Link="Core\MarkdownLite.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\ChatStore.cs" Link="Core\ChatStore.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\PaletteSettings.cs" Link="Core\PaletteSettings.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\QuickTemplates.cs" Link="Core\QuickTemplates.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\SkillStore.cs" Link="Core\SkillStore.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Macros.cs" Link="Core\Macros.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\ChatExtras.cs" Link="Core\ChatExtras.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\DrawingHistoryCore.cs" Link="Core\DrawingHistoryCore.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Diagnostics.cs" Link="Core\Diagnostics.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\License.cs" Link="Core\License.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Plans.cs" Link="Core\Plans.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Solids.cs" Link="Core\Solids.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Edition.cs" Link="Core\Edition.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Solids2.cs" Link="Core\Solids2.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\FloorPlan.cs" Link="Core\FloorPlan.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\Railing.cs" Link="Core\Railing.cs" />
    <Compile Include="..\ClaudeCAD.Plugin\Core\SelfTestRules.cs" Link="Core\SelfTestRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
