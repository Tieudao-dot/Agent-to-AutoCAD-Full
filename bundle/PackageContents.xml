<?xml version="1.0" encoding="utf-8"?>
<!--
  Autodesk autoloader manifest for ClaudeCAD (shown as "Agent to AutoCAD Full").
  Decided 12/11/2026: the Full edition replaces the original ClaudeCAD as an upgrade, so ProductCode, UpgradeCode,
  the ComponentEntry AppName values and the commands stay the same; only the names people read changed.
  Install: copy the whole ClaudeCAD.bundle folder to %AppData%\Autodesk\ApplicationPlugins
  (per user) or %ProgramData%\Autodesk\ApplicationPlugins (all users), or run installer\install.ps1.

  Three builds of the same plugin:
    R24.1 - R24.3  AutoCAD 2022 / 2023 / 2024  (.NET Framework 4.8)  Contents\ClaudeCAD.Plugin.dll
    R25.0 - R25.1  AutoCAD 2025 / 2026         (.NET 8; still loads after the .NET 10 updates of 2025/2026)
                                                                     Contents\2025\ClaudeCAD.Plugin.dll
    R26.0          AutoCAD 2027                (.NET 10, not binary compatible with R25)
                                                                     Contents\2027\ClaudeCAD.Plugin.dll
  SeriesMax is always an explicit release: a future AutoCAD (R26.1+) must not load a build it was not tested on.
  Platform "AutoCAD*" = AutoCAD and its verticals; AutoCAD LT is not supported.
  AppVersion / Version are stamped by bundle/make-bundle.mjs.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="Agent to AutoCAD Full"
    Description="Agent to AutoCAD Full: chat với Claude trong AutoCAD, vẽ 2D và dựng 3D, đọc, sửa bản vẽ bằng tiếng Việt."
    AppVersion="0.9.4"
    Author="ClaudeCAD"
    ProductCode="{8D3C1A52-6E4B-4F0A-9C27-3B5E7A1D9F40}"
    UpgradeCode="{2A7F5C19-0B8E-4D63-A1F4-6C9E2B7D5A08}"
    HelpFile="./Contents/README.md">
  <CompanyDetails Name="ClaudeCAD" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.1" SeriesMax="R26.0" />

  <Components Description="Agent to AutoCAD Full for AutoCAD 2022-2024 (.NET Framework 4.8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.1" SeriesMax="R24.3" />
    <ComponentEntry
        AppName="ClaudeCAD"
        Version="0.9.4"
        ModuleName="./Contents/ClaudeCAD.Plugin.dll"
        AppDescription="Agent to AutoCAD Full: chat palette and 2D / 3D drawing tools"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="CLAUDECAD">
        <Command Global="CLAUDECHAT" Local="CLAUDECHAT" />
        <Command Global="CLAUDECHATRESTART" Local="CLAUDECHATRESTART" />
        <Command Global="CLAUDECHATUPDATE" Local="CLAUDECHATUPDATE" />
        <Command Global="CLAUDECHATLOG" Local="CLAUDECHATLOG" />
      </Commands>
    </ComponentEntry>
  </Components>

  <Components Description="Agent to AutoCAD Full for AutoCAD 2025-2026 (.NET 8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.1" />
    <ComponentEntry
        AppName="ClaudeCAD2025"
        Version="0.9.4"
        ModuleName="./Contents/2025/ClaudeCAD.Plugin.dll"
        AppDescription="Agent to AutoCAD Full: chat palette and 2D / 3D drawing tools"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="CLAUDECAD">
        <Command Global="CLAUDECHAT" Local="CLAUDECHAT" />
        <Command Global="CLAUDECHATRESTART" Local="CLAUDECHATRESTART" />
        <Command Global="CLAUDECHATUPDATE" Local="CLAUDECHATUPDATE" />
        <Command Global="CLAUDECHATLOG" Local="CLAUDECHATLOG" />
      </Commands>
    </ComponentEntry>
  </Components>

  <Components Description="Agent to AutoCAD Full for AutoCAD 2027 (.NET 10)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" />
    <ComponentEntry
        AppName="ClaudeCAD2027"
        Version="0.9.4"
        ModuleName="./Contents/2027/ClaudeCAD.Plugin.dll"
        AppDescription="Agent to AutoCAD Full: chat palette and 2D / 3D drawing tools"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="CLAUDECAD">
        <Command Global="CLAUDECHAT" Local="CLAUDECHAT" />
        <Command Global="CLAUDECHATRESTART" Local="CLAUDECHATRESTART" />
        <Command Global="CLAUDECHATUPDATE" Local="CLAUDECHATUPDATE" />
        <Command Global="CLAUDECHATLOG" Local="CLAUDECHATLOG" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
