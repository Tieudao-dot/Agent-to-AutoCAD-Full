<?xml version="1.0" encoding="utf-8"?>
<!--
  Autodesk autoloader manifest for ClaudeCAD.
  Copy the whole ClaudeCAD.bundle folder to %AppData%\Autodesk\ApplicationPlugins
  (per user) or %ProgramData%\Autodesk\ApplicationPlugins (all users).
  SeriesMin/SeriesMax R24.1 = AutoCAD 2022 only (phase 1). Platform "AutoCAD*"
  = AutoCAD and its verticals; AutoCAD LT is not supported.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="ClaudeCAD"
    Description="Chat với Claude trong AutoCAD: vẽ, đọc, sửa bản vẽ bằng tiếng Việt."
    AppVersion="0.1.0"
    Author="ClaudeCAD"
    ProductCode="{8D3C1A52-6E4B-4F0A-9C27-3B5E7A1D9F40}"
    UpgradeCode="{2A7F5C19-0B8E-4D63-A1F4-6C9E2B7D5A08}"
    HelpFile="./Contents/README.md">
  <CompanyDetails Name="ClaudeCAD" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.1" SeriesMax="R24.1" />
  <Components Description="ClaudeCAD plugin">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.1" SeriesMax="R24.1" />
    <ComponentEntry
        AppName="ClaudeCAD"
        Version="0.1.0"
        ModuleName="./Contents/ClaudeCAD.Plugin.dll"
        AppDescription="ClaudeCAD chat palette and drawing tools"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="CLAUDECAD">
        <Command Global="CLAUDECHAT" Local="CLAUDECHAT" />
        <Command Global="CLAUDECHATRESTART" Local="CLAUDECHATRESTART" />
        <Command Global="CLAUDECHATLOG" Local="CLAUDECHATLOG" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
