{
  "name": "claudecad-agent",
  "version": "0.1.0",
  "private": true,
  "description": "ClaudeCAD sidecar: runs Claude (Agent SDK) and forwards CAD tool calls to the AutoCAD plugin over a named pipe.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json",
    "test": "npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev:fake-plugin": "node dist-test/test/fakePlugin.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
